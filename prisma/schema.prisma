// ServiceFlow Pro - Multi-tenant SaaS schema
// Switch provider to "postgresql" + Neon/Supabase DATABASE_URL for production

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
}

// ─── Auth & Multi-tenancy ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // null if OAuth-only
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  assignedJobs  Job[]     @relation("AssignedTech")
  soldJobs      Job[]     @relation("SoldBy")
  uploadedFiles JobFile[]
  reviews       Review[]  @relation("ReviewAuthor")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  phone            String?
  email            String?
  address          String?
  logoUrl          String?
  stripeCustomerId String?
  stripeSubId      String?
  plan             String   @default("free")
  planStatus       String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships Membership[]
  jobs        Job[]
  invoices    Invoice[]
  reviews     Review[]
  customers   Customer[]

  @@index([slug])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  name      String
  email     String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs     Job[]
  invoices Invoice[]
  reviews  Review[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
}

model Job {
  id               String    @id @default(cuid())
  companyId        String
  customerId       String
  title            String
  description      String?
  status           String    @default("estimate")
  assignedToId     String?
  estimateAmount   Float?
  invoiceAmount    Float?
  scheduledDate    String?
  scheduledTime    String?
  completedAt      DateTime?
  soldAt           DateTime?
  soldById         String?
  address          String?
  notes            String?
  privateNotes     String?
  timeSpentMinutes Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("AssignedTech", fields: [assignedToId], references: [id])
  soldBy     User?     @relation("SoldBy", fields: [soldById], references: [id])
  files      JobFile[]
  invoice    Invoice?
  reviews    Review[]

  @@index([companyId, status])
  @@index([companyId, scheduledDate])
  @@index([assignedToId])
  @@index([customerId])
}

model JobFile {
  id           String   @id @default(cuid())
  jobId        String
  name         String
  url          String
  isPrivate    Boolean  @default(false)
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  uploadedAt   DateTime @default(now())

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([jobId])
}

model Invoice {
  id                    String    @id @default(cuid())
  companyId             String
  jobId                 String    @unique
  customerId            String
  amount                Float
  status                String    @default("draft")
  dueDate               DateTime?
  paidAt                DateTime?
  stripePaymentIntentId String?
  lineItems             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([customerId])
}

model Review {
  id           String    @id @default(cuid())
  companyId    String
  jobId        String
  customerId   String?
  authorId     String?
  customerName String
  rating       Int       @default(0)
  comment      String?
  status       String    @default("pending")
  requestedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  author   User?     @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@index([companyId, status])
  @@index([jobId])
}
