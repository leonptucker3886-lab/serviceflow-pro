# Database (SQLite local / Neon or Supabase for production)
# Local: file:./dev.db
# Production: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL is also used by Auth.js v5
AUTH_URL="http://localhost:3000"

# Stripe (customer payments + SaaS subscription billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for ServiceFlow plans
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="ServiceFlow <noreply@yourdomain.com>"

# File storage (optional – Vercel Blob / S3 / R2)
# BLOB_READ_WRITE_TOKEN="..."
